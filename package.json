{
  "name": "parsistent",
  "version": "0.0.2",
  "description": "Typed localStorage, sessionStorage and cookies, shaped like the browser APIs: validated values, defaults, cross-tab sync and SSR-safe React hooks",
  "license": "MIT",
  "author": {
    "name": "Somraj Mukherjee",
    "email": "iamsomraj@gmail.com",
    "url": "https://github.com/iamsomraj"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "react": [
        "./dist/react.d.ts"
      ]
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "keywords": [
    "react",
    "react-hooks",
    "localstorage",
    "sessionstorage",
    "cookies",
    "cookie-store",
    "web-storage",
    "persist",
    "persistent-state",
    "typescript",
    "type-safe",
    "standard-schema",
    "zod",
    "nuqs",
    "ssr",
    "nextjs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iamsomraj/parsistent.git"
  },
  "bugs": {
    "url": "https://github.com/iamsomraj/parsistent/issues"
  },
  "homepage": "https://github.com/iamsomraj/parsistent#readme",
  "scripts": {
    "dev": "tsup --watch",
    "build": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\" && tsup",
    "test": "vitest run --typecheck",
    "test:watch": "vitest --typecheck",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "format:fix": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "prepublishOnly": "bun run typecheck && bun run lint && bun run test && bun run build && bun run test:dist",
    "test:dist": "tsc -p tests/published-types/tsconfig.json"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "packageManager": "bun@1.4.3",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^10.12.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.1",
    "nuqs": "^2.10.2",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^8.5.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.4",
    "zod": "^4.6.7"
  }
}
